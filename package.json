{
  "name": "mairieconnect",
  "version": "1.0.0",
  "private": true,
  "description": "MairieConnect - Application souveraine de signalements citoyens pour collectivite (RGPD, eco-concue, securisee).",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --minify",
    "build": "npm run build:css && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:seed": "tsx src/db/seed.ts",
    "purge:run": "tsx src/services/purge.service.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jimp/core": "^1.6.1",
    "@jimp/js-jpeg": "^1.6.1",
    "@jimp/js-png": "^1.6.1",
    "@jimp/plugin-resize": "^1.6.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
