# =============================================================
# MairieConnect - Variables d'environnement
# Copier ce fichier en ".env" et adapter les valeurs AVANT de
# lancer l'application. Ne jamais committer le fichier ".env" reel.
# =============================================================

# Environnement d'execution : "development" ou "production"
NODE_ENV=development

# Port d'ecoute du serveur HTTP (le reverse-proxy / Apache o2switch
# se charge du HTTPS et redirige vers ce port en local)
PORT=3000

# Nom de la commune affiche dans l'interface (personnalisable a la vente)
COMMUNE_NAME=Commune de Tigy

# Prefixe utilise pour generer les codes de suivi (ex: TIGY-8492)
REFERENCE_CODE_PREFIX=TIGY

# Chemin du fichier de base de donnees SQLite (relatif a la racine du projet)
DB_PATH=./data/mairieconnect.db

# Dossier de stockage des photos (HORS du dossier public : diffusion
# uniquement via un handler qui verifie le nom de fichier)
UPLOAD_DIR=./data/uploads

# Taille maximale d'un fichier uploade, en Mo, avant compression serveur
MAX_UPLOAD_MB=8

# Secret de signature des sessions (obligatoire, generer une valeur aleatoire
# forte en production : ex. openssl rand -hex 32)
SESSION_SECRET=change_moi_avec_une_valeur_aleatoire_longue_et_secrete

# Duree de vie de la session agent (en heures)
SESSION_MAX_AGE_HOURS=8

# Compte administrateur cree automatiquement au premier demarrage
# (a changer immediatement apres la premiere connexion)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeMoiImmediatement!2024

# Politique de conservation des donnees (RGPD) : nombre de jours apres
# resolution/rejet d'un signalement avant anonymisation automatique
DATA_RETENTION_DAYS=365

# --- Mentions legales (obligatoires avant ouverture au public, LCEN + RGPD) ---
# Identite de la commune editrice
COMMUNE_ADDRESS=32 rue de Sully, BP 6, 45510 Tigy
COMMUNE_PHONE=02 38 58 00 49
COMMUNE_EMAIL=accueil@exemple.fr
COMMUNE_SIREN=000 000 000
# Directeur de la publication : en principe le maire
PUBLICATION_DIRECTOR=Le maire
# Contact du delegue a la protection des donnees (obligatoire pour une commune)
DPO_CONTACT=
# Hebergeur du site (nom, adresse, telephone)
HOST_NAME=
HOST_ADDRESS=
HOST_PHONE=

# En local : 0. Derriere Apache/o2switch : 1 (obligatoire en production)
TRUST_PROXY_HOPS=0

# --- Deux adresses distinctes (obligatoire des la mise en ligne) ---
# Site citoyen, ouvert sur Internet :
PUBLIC_HOST=signalement.ma-commune.fr
# Espace agents, nom interne (VPN, reseau mairie, ou sous-domaine non public) :
ADMIN_HOST=agents.ma-commune.lan
# IP ou reseaux autorises a ouvrir ADMIN_HOST (vide = pas de filtre IP).
# En production, limiter au reseau de la mairie.
ADMIN_ALLOWED_IPS=10.0.0.0/8,192.168.0.0/16
