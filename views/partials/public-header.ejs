<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="description" content="Signalez un probleme sur la voie publique a <%= communeName %> : voirie, eclairage, proprete, espaces verts, batiments." />
  <meta name="theme-color" content="#123b5c" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="min-h-screen flex flex-col">
  <a href="#contenu-principal" class="skip-link">Aller au contenu</a>
  <header class="sticky top-0 z-20 border-b border-slate-200/80 bg-white text-slate-900">
    <div class="shell flex items-center justify-between gap-3 py-3">
      <a href="/" class="flex min-w-0 items-center gap-3">
        <span class="brand-mark shrink-0" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="currentColor"><path d="M16 6l8 5v3H8V11l8-5zm-7 10h2v8H9v-8zm6 0h2v8h-2v-8zm6 0h2v8h-2v-8zM8 25h16v2H8z"/></svg>
        </span>
        <span class="min-w-0">
          <span class="block truncate text-sm font-semibold leading-tight text-mairie-900"><%= communeName %></span>
          <span class="block text-xs font-medium text-slate-600">Signalements citoyens</span>
        </span>
      </a>
      <nav class="flex shrink-0 gap-1" aria-label="Navigation principale">
        <a href="/" class="min-h-11 rounded-full px-3 py-2 text-sm font-semibold <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'bg-mairie-800 text-white' : 'text-slate-700 hover:bg-slate-100' %>" <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'aria-current="page"' : '' %>>Signaler</a>
        <a href="/suivi" class="min-h-11 rounded-full px-3 py-2 text-sm font-semibold <%= typeof currentPath !== 'undefined' && (currentPath === '/suivi') ? 'bg-mairie-800 text-white' : 'text-slate-700 hover:bg-slate-100' %>" <%= typeof currentPath !== 'undefined' && currentPath === '/suivi' ? 'aria-current="page"' : '' %>>Suivre</a>
      </nav>
    </div>
  </header>
  <main id="contenu-principal" class="shell flex-1 py-5 sm:py-10" tabindex="-1">
