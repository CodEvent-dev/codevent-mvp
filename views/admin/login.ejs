<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#0a1f32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="screen-admin relative min-h-screen overflow-hidden px-4">
  <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-or-500/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -right-16 h-80 w-80 rounded-full bg-mairie-500/30 blur-3xl"></div>

  <div class="relative mx-auto flex min-h-screen max-w-md flex-col justify-center">
    <div class="mb-8 text-center">
      <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-or-500 text-mairie-900">
        <svg width="22" height="22" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 6l8 5v3H8V11l8-5zm-7 10h2v8H9v-8zm6 0h2v8h-2v-8zm6 0h2v8h-2v-8zM8 25h16v2H8z"/></svg>
      </div>
      <h1 class="text-xl font-bold text-white"><%= communeName %></h1>
      <p class="mt-1 text-sm text-white/80">Espace agent — acces securise</p>
    </div>

    <form method="POST" action="/admin/login" class="card" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <% if (error) { %>
        <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800" role="alert">
          <%= error %>
        </div>
      <% } %>

      <label for="username" class="mb-1.5 block text-sm font-medium text-slate-700">Identifiant</label>
      <input type="text" id="username" name="username" class="input-field mb-4" required autofocus autocomplete="username" maxlength="64" />

      <label for="password" class="mb-1.5 block text-sm font-medium text-slate-700">Mot de passe</label>
      <input type="password" id="password" name="password" class="input-field mb-6" required autocomplete="current-password" maxlength="128" />

      <button type="submit" class="btn-primary w-full">Se connecter</button>
    </form>

    <p class="mt-6 text-center text-xs text-white/80">Connexion reservee aux agents municipaux habilites.</p>
  </div>
</body>
</html>
