<%- include('../partials/admin-header') %>

<section class="hero mb-6">
  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-or-400">Services techniques</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight">Tableau de bord</h1>
  <p class="mt-2 max-w-xl text-base text-white">
    <% if (isGlobalViewer) { %>
      Vue d'ensemble des signalements, filtres, exports et archivage.
    <% } else { %>
      Tickets de vos services uniquement<% if (visibleCategories.length) { %> : <%= visibleCategories.map(function (c) { return c.label; }).join(', ') %><% } %>.
    <% } %>
  </p>
</section>

<div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
  <div class="stat-card">
    <p class="text-sm font-medium text-slate-500">En attente</p>
    <p class="mt-2 text-4xl font-bold tracking-tight text-sky-700"><%= stats.totalEnAttente %></p>
    <p class="mt-2 text-sm text-slate-600">Nouveaux, pas encore pris en charge</p>
  </div>
  <div class="stat-card">
    <p class="text-sm font-medium text-slate-500">En cours</p>
    <p class="mt-2 text-4xl font-bold tracking-tight text-orange-600"><%= stats.totalEnCours %></p>
    <p class="mt-2 text-sm text-slate-600">Pris en compte ou en intervention</p>
  </div>
  <div class="stat-card">
    <p class="text-sm font-medium text-slate-500">Resolus</p>
    <p class="mt-2 text-4xl font-bold tracking-tight text-emerald-700"><%= stats.totalResolus %></p>
    <p class="mt-2 text-sm text-slate-600">Clotures par les equipes</p>
  </div>
</div>

<form method="GET" action="/admin/dashboard" class="card mb-6 grid grid-cols-1 items-end gap-3 sm:grid-cols-2 lg:grid-cols-5">
  <div>
    <label for="filter-status" class="mb-1 block text-sm font-medium text-slate-700">Statut</label>
    <select id="filter-status" name="status" class="input-field">
      <option value="">Tous</option>
      <option value="nouveau" <%= filters.status === 'nouveau' ? 'selected' : '' %>>Nouveau</option>
      <option value="pris_en_compte" <%= filters.status === 'pris_en_compte' ? 'selected' : '' %>>Pris en compte</option>
      <option value="en_cours" <%= filters.status === 'en_cours' ? 'selected' : '' %>>En cours</option>
      <option value="resolu" <%= filters.status === 'resolu' ? 'selected' : '' %>>Resolu</option>
      <option value="rejete" <%= filters.status === 'rejete' ? 'selected' : '' %>>Rejete</option>
    </select>
  </div>
  <div>
    <label for="filter-category" class="mb-1 block text-sm font-medium text-slate-700">Categorie</label>
    <select id="filter-category" name="category" class="input-field">
      <option value="">Toutes</option>
      <% visibleCategories.forEach(function (cat) { %>
        <option value="<%= cat.value %>" <%= filters.category === cat.value ? 'selected' : '' %>><%= cat.label %></option>
      <% }); %>
    </select>
  </div>
  <div>
    <label for="filter-sort" class="mb-1 block text-sm font-medium text-slate-700">Tri</label>
    <select id="filter-sort" name="sort" class="input-field">
      <option value="date_desc" <%= filters.sort === 'date_desc' ? 'selected' : '' %>>Plus recents</option>
      <option value="date_asc" <%= filters.sort === 'date_asc' ? 'selected' : '' %>>Plus anciens</option>
    </select>
  </div>
  <div>
    <label for="filter-q" class="mb-1 block text-sm font-medium text-slate-700">Recherche</label>
    <input id="filter-q" type="text" name="q" value="<%= filters.q || '' %>" class="input-field" placeholder="Code, adresse..." maxlength="100" />
  </div>
  <div>
    <button type="submit" class="btn-primary w-full">Filtrer</button>
  </div>
</form>

<div class="mb-6 flex flex-wrap gap-3">
  <a href="/admin/export/csv" class="btn-secondary">Export CSV</a>
  <a href="/admin/export/pdf" class="btn-secondary">Export PDF</a>
  <% if (currentAgentRole === 'admin') { %>
    <form id="purge-form" action="/admin/purge" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn-secondary">Purger les archives (RGPD)</button>
    </form>
  <% } %>
</div>

<div class="ticket-cards">
  <% signalements.forEach(function(s) { %>
    <article class="card">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <p class="font-mono text-lg font-bold text-mairie-900"><%= s.reference_code %></p>
        <%- include('../partials/status-badge', { status: s.status, statusLabel: s.statusLabel }) %>
      </div>
      <p class="mt-2 text-base text-slate-800"><%= s.serviceLabel %> · <%= s.assigned_agent_username || 'Service' %></p>
      <p class="mt-1 text-sm text-slate-700"><%= s.address %></p>
      <p class="mt-1 text-sm text-slate-600">Cree le <%= new Date(s.created_at).toLocaleDateString('fr-FR') %></p>
      <a href="/admin/signalements/<%= s.id %>" class="mt-3 inline-flex min-h-11 items-center font-semibold text-mairie-800 underline">Voir le ticket <%= s.reference_code %></a>
    </article>
  <% }); %>
  <% if (signalements.length === 0) { %>
    <p class="card text-center text-slate-600">Aucun signalement ne correspond a ces criteres.</p>
  <% } %>
</div>

<div class="card ticket-table overflow-x-auto p-0">
  <table class="min-w-full text-sm">
    <caption class="sr-only">Liste des signalements de votre perimetre</caption>
    <thead>
      <tr class="border-b border-slate-100 bg-slate-50/80 text-left text-xs uppercase tracking-wide text-slate-600">
        <th scope="col" class="px-5 py-3 font-semibold">Code</th>
        <th scope="col" class="px-5 py-3 font-semibold">Service</th>
        <th scope="col" class="px-5 py-3 font-semibold">Affecte a</th>
        <th scope="col" class="px-5 py-3 font-semibold">Adresse</th>
        <th scope="col" class="px-5 py-3 font-semibold">Statut</th>
        <th scope="col" class="px-5 py-3 font-semibold">Cree le</th>
        <th scope="col" class="px-5 py-3 font-semibold"><span class="sr-only">Action</span></th>
      </tr>
    </thead>
    <tbody>
      <% signalements.forEach(function(s) { %>
        <tr class="border-b border-slate-50 transition hover:bg-mairie-50/40">
          <td class="px-5 py-3 font-mono font-medium text-mairie-800"><%= s.reference_code %></td>
          <td class="px-5 py-3"><%= s.serviceLabel %></td>
          <td class="px-5 py-3 text-slate-700"><%= s.assigned_agent_username || 'Service' %></td>
          <td class="max-w-xs truncate px-5 py-3 text-slate-700"><%= s.address %></td>
          <td class="px-5 py-3">
            <%- include('../partials/status-badge', { status: s.status, statusLabel: s.statusLabel }) %>
          </td>
          <td class="whitespace-nowrap px-5 py-3 text-slate-600"><%= new Date(s.created_at).toLocaleDateString('fr-FR') %></td>
          <td class="px-5 py-3">
            <a href="/admin/signalements/<%= s.id %>" class="font-semibold text-mairie-700 underline hover:text-mairie-900">Voir <%= s.reference_code %></a>
          </td>
        </tr>
      <% }); %>
      <% if (signalements.length === 0) { %>
        <tr>
          <td colspan="7" class="px-5 py-10 text-center text-slate-600">Aucun signalement ne correspond a ces criteres.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<script src="/js/admin-dashboard.js"></script>

<%- include('../partials/admin-footer') %>
